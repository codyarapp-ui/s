# ---------------------------------------------------------------
# Database connection (required). Fill these on the server .env file.
# ---------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------
# Admin identity
# ---------------------------------------------------------------
# شماره موبایل و شناسه مدیر ارشد. اگر خالی بمانند مقادیر پیش‌فرض استفاده می‌شوند.
ADMIN_PHONE=
ADMIN_ROOT_ID=
SUPPORT_PHONE=

# رمز مدیر — فقط برای بازیابی اضطراری (مثلاً وقتی رمز داخل دیتابیس گم شده است).
# پس از اولین ورود موفق، رمز به صورت bcrypt در جدول users ذخیره می‌شود و
# توصیه می‌شود این متغیر را دوباره خالی کنید.
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------
# GEMINI_API_KEY: required for Gemini AI diagnosis calls.
GEMINI_API_KEY=

# ---------------------------------------------------------------
# متغیرهای حذف‌شده (دیگر خوانده نمی‌شوند — اگر در .env سرور هستند پاکشان کنید):
#
#   ALLOW_LEGACY_ID_AUTH    هر کسی با فرستادن رشته «us_admin_root» در یک هدر،
#                           بدون هیچ رمزی مدیر کل می‌شد.
#   ADMIN_MASTER_PASSWORDS  فهرست رمزهای پشتیبان که همگی دسترسی کامل مدیر می‌دادند.
# ---------------------------------------------------------------

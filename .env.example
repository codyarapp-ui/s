# Database connection (required). Fill these on the server .env file.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# Admin password used by the admin panel login.
ADMIN_PASSWORD=

# Optional comma separated emergency master passwords. Leave empty in production.
ADMIN_MASTER_PASSWORDS=

# Set to true ONLY as a temporary emergency fallback. It restores the old behaviour
# where sending the admin user id as a token granted admin access. Keep it empty/false.
ALLOW_LEGACY_ID_AUTH=

# GEMINI_API_KEY: required for Gemini AI diagnosis calls.
GEMINI_API_KEY=
